# Optional. Without this key the router uses deterministic local analysis only.
OPENAI_API_KEY=

# Keep API model IDs configurable because providers rename things with the serenity of a raccoon in a server room.
OPENAI_ROUTER_MODEL_ID=
OPENAI_FAST_MODEL_ID=
OPENAI_BALANCED_MODEL_ID=
OPENAI_FRONTIER_MODEL_ID=
OPENAI_BASE_URL=

# Router behavior
ENABLE_SEMANTIC_ANALYZER=true
ROUTER_MIN_CONFIDENCE=0.72
MAX_PARALLEL_STEPS=4

# OpenCode live adapter validation.
# `opencode serve` defaults to http://127.0.0.1:4096.
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_PROJECT_DIR=
# Only needed when the OpenCode server is protected with Basic Auth.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# Default preflight is read-only. Set to true only to create and then delete a temporary R0 session.
OPENCODE_LIVE_SESSION_SMOKE=false
# Keep false for local-first operation. Remote servers require explicit network/credential policy review.
OPENCODE_ALLOW_REMOTE=false
